{
    "compilerOptions": {
        "declaration": true,
        "declarationDir": "dist",
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "outDir": "dist",
        "rootDir": "src",
        "jsx": "react-jsx",
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "target": "ESNext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["react"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
